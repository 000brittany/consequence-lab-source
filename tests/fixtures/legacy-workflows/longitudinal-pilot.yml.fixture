name: Manual Rooms v2 pilot
run-name: Rooms v2 pilot | ${{ inputs.mode }} | scenario=${{ inputs.scenario }} | rooms-v2-pressure-communication-v1 | core=faeccaa${{ inputs.protocol_recovery && ' | recovery=protocol-42317362851-once' || '' }}
on:
  workflow_dispatch:
    inputs:
      mode:
        description: Offline by default; paid requires separate researcher approval
        type: choice
        options: [offline, paid]
        default: offline
        required: true
      scenario:
        description: One scenario per deliberate dispatch
        type: choice
        options: [diagnostic, lower_pressure, shared_disabled]
        default: diagnostic
        required: true
      paid_authorization:
        description: Approve only the selected scenario, 192 generations and USD 10 estimated ceiling
        type: choice
        options: ['NO', AUTHORIZE_ROOMS_V2_DIAGNOSTIC_192_CALLS_USD_10, AUTHORIZE_ROOMS_V2_LOWER_PRESSURE_192_CALLS_USD_10, AUTHORIZE_ROOMS_V2_SHARED_DISABLED_192_CALLS_USD_10, AUTHORIZE_PROTOCOL_REPAIR_RECOVERY_42317362851_ONCE_192_CALLS_USD_10]
        default: 'NO'
        required: true
      protocol_recovery:
        description: Single protocol-repair replacement for aborted run 42317362851; diagnostic only
        type: boolean
        default: false
        required: true
permissions:
  contents: read
  actions: read
concurrency:
  group: longitudinal-pilot-single-run
  cancel-in-progress: false
jobs:
  pilot:
    runs-on: ubuntu-latest
    timeout-minutes: 150
    env:
      MODE: ${{ inputs.mode }}
      SCENARIO: ${{ inputs.scenario }}
      PAID_AUTHORIZATION: ${{ inputs.paid_authorization }}
      PROTOCOL_RECOVERY: ${{ inputs.protocol_recovery && 'true' || 'false' }}
      DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Preserve startup identity before checkout
        shell: python
        env:
          RESULTS_DIR: ${{ runner.temp }}/longitudinal-pilot-results
        run: |
          import json, os
          from pathlib import Path
          root = Path(os.environ['RESULTS_DIR'])
          root.mkdir(parents=True, exist_ok=True)
          with Path(os.environ['GITHUB_ENV']).open('a') as stream:
              stream.write(f'RESULTS_DIR={root}\n')
          (root/'startup.json').write_text(json.dumps({k: os.environ.get(k) for k in
              ('GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_WORKFLOW_REF', 'GITHUB_WORKFLOW_SHA')}, indent=2))
      - name: Check out launch infrastructure
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4; same Colosseum pin
        with:
          ref: ${{ github.workflow_sha }}
          path: launcher
          persist-credentials: false
      - name: Validate manual authorization and reject previous paid execution
        working-directory: launcher
        timeout-minutes: 2
        env:
          ACTIONS_READ_TOKEN: ${{ github.token }}
        run: python -m tools.longitudinal_pilot guard --mode "$MODE" --scenario "$SCENARIO" --output "$RESULTS_DIR"
      - name: Check out exact versioned scientific source
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: faeccaa03b8e4a0f4129d916ff520f4d5a4c0111
          path: core
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5; same Colosseum pin
        with:
          python-version: '3.12'
      - name: Install existing provider dependency
        id: setup
        timeout-minutes: 5
        run: python -m pip install -e './core[provider]'
      - name: Offline initialization and acceptance fixtures
        shell: bash
        if: ${{ inputs.mode == 'offline' }}
        working-directory: launcher
        run: |
          set -euo pipefail
          python -m unittest discover -s tests -p test_longitudinal_pilot.py -v 2>&1 | tee "$RESULTS_DIR/offline-tests.log"
          python -m unittest discover -s tests -p test_pilot_protocol_recovery.py -v 2>&1 | tee "$RESULTS_DIR/recovery-tests.log"
          python -m tools.pilot_validation --output "$RESULTS_DIR/mock-validation" > "$RESULTS_DIR/mock-validation-report.json"
          python -m tools.longitudinal_pilot run --mode offline --scenario "$SCENARIO" --core ../core --output "$RESULTS_DIR"
      - name: One separately authorized paid pilot
        if: ${{ inputs.mode == 'paid' }}
        working-directory: launcher
        timeout-minutes: 125
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: python -m tools.longitudinal_pilot run --mode paid --scenario "$SCENARIO" --core ../core --output "$RESULTS_DIR"
      - name: Independent verification and analysis of saved records
        if: ${{ always() && steps.setup.outcome == 'success' }}
        working-directory: launcher
        run: |
          if [ -d "$RESULTS_DIR/research/records" ]; then
            python -m tools.pilot_analysis "$RESULTS_DIR/research" --allow-incomplete --output "$RESULTS_DIR/analysis.json"
          fi
      - name: Upload complete records including incomplete or error outputs
        if: ${{ always() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4; same Colosseum pin
        with:
          name: longitudinal-pilot-${{ inputs.scenario }}-${{ inputs.mode }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/longitudinal-pilot-results/
          if-no-files-found: error
          retention-days: 30
