name: Manual Luna calibration
run-name: Luna calibration | ${{ inputs.mode }} | setting=${{ inputs.context_setting }} | baseline=5a62670${{ inputs.paid_authorization == 'AUTHORIZE_GENEROUS_AFTER_42222898985_ONCE_USD_0_33' && ' | recovery=42222898985-once' || '' }}
on:
  workflow_dispatch:
    inputs:
      mode:
        description: Offline by default; paid requires separate researcher approval
        type: choice
        options: [offline, paid]
        default: offline
        required: true
      context_setting:
        description: One setting per deliberate dispatch
        type: choice
        options: [generous, moderate]
        default: generous
        required: true
      paid_authorization:
        description: Authorize one setting only, at most eight generations and USD 0.33 estimated spend
        type: choice
        options: ['NO', AUTHORIZE_ONE_CALIBRATION_8_CALLS_USD_0_33, AUTHORIZE_GENEROUS_AFTER_42222898985_ONCE_USD_0_33]
        default: 'NO'
        required: true
permissions:
  contents: read
  actions: read
concurrency:
  group: luna-calibration-single-run
  cancel-in-progress: false
jobs:
  calibration:
    runs-on: ubuntu-latest
    timeout-minutes: 35
    env:
      MODE: ${{ inputs.mode }}
      SETTING: ${{ inputs.context_setting }}
      PAID_AUTHORIZATION: ${{ inputs.paid_authorization }}
      DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
      PYTHONDONTWRITEBYTECODE: '1'
    steps:
      - name: Preserve startup identity before checkout
        shell: python
        env:
          RESULTS_DIR: ${{ runner.temp }}/luna-calibration-results
        run: |
          import json, os
          from pathlib import Path
          root = Path(os.environ['RESULTS_DIR'])
          root.mkdir(parents=True, exist_ok=True)
          with Path(os.environ['GITHUB_ENV']).open('a') as stream:
              stream.write(f'RESULTS_DIR={root}\n')
          (root/'startup.json').write_text(json.dumps({k: os.environ.get(k) for k in
              ('GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_WORKFLOW_REF', 'GITHUB_WORKFLOW_SHA')}, indent=2))
      - name: Check out launch infrastructure
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4; same Colosseum pin
        with:
          ref: ${{ github.workflow_sha }}
          path: launcher
          persist-credentials: false
      - name: Validate manual authorization and reject previous paid execution
        timeout-minutes: 2
        env:
          ACTIONS_READ_TOKEN: ${{ github.token }}
        run: python launcher/tools/calibration_launcher.py guard --mode "$MODE" --setting "$SETTING" --output "$RESULTS_DIR"
      - name: Check out frozen Milestone 3 baseline
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: 5a6267052fffbc0e3aec8da819d7dc47f6d66ee4
          path: core
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5; same Colosseum pin
        with:
          python-version: '3.12'
      - name: Install existing provider dependency
        timeout-minutes: 5
        run: python -m pip install -e './core[provider]'
      - name: Offline checks
        if: ${{ inputs.mode == 'offline' }}
        env:
          EIG_REQUIRE_PROVIDER: '1'
          PYTHONPATH: launcher
        run: |
          python -m unittest discover -s launcher/tests -p test_calibration_launcher.py -v
          python -m unittest discover -s core/tests -p test_provider.py -v
          python launcher/tools/calibration_launcher.py run --mode offline --setting "$SETTING" --core core --output "$RESULTS_DIR"
      - name: One separately authorized paid calibration
        if: ${{ inputs.mode == 'paid' }}
        timeout-minutes: 17
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: python launcher/tools/calibration_launcher.py run --mode paid --setting "$SETTING" --core core --output "$RESULTS_DIR"
      - name: Upload complete records including incomplete or error outputs
        if: ${{ always() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4; same Colosseum pin
        with:
          name: luna-calibration-${{ inputs.context_setting }}-${{ inputs.mode }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/luna-calibration-results/
          if-no-files-found: error
          retention-days: 30
